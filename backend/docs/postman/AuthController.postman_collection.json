      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json = {};",
              "try { json = pm.response.json(); } catch (e) {}",
              "",
              "pm.test('Phone-only login is handled without server error', function () {",
              "  pm.expect(pm.response.code).to.not.eql(500);",
              "});",
              "",
              "pm.test('Phone-only login either succeeds or returns invalid credentials', function () {",
              "  pm.expect([200, 401]).to.include(pm.response.code);",
              "  if (pm.response.code === 200) {",
              "    pm.expect(json.success).to.eql(true);",
              "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "  } else {",
              "    pm.expect(json.errorCode).to.eql('INVALID_CREDENTIALS');",
              "  }",
              "});"
            ]
          }
        }
