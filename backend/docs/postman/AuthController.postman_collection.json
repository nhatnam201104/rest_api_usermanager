{
  "info": {
    "_postman_id": "3e74b8af-50ea-4c3a-8d31-2e2c0c287f57",
    "name": "SocialManagement - AuthController Tests",
    "description": "Postman collection for AuthController. Run with Collection Runner from top to bottom. The first register request creates unique collection variables, saves the returned OTP, then later requests verify OTP, login, and cover auth/validation failures. App default base URL: http://localhost:8081.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('baseUrl')) {",
          "  pm.collectionVariables.set('baseUrl', 'http://localhost:8081');",
          "}",
          "if (!pm.collectionVariables.get('fullName')) {",
          "  pm.collectionVariables.set('fullName', 'Postman Auth Tester');",
          "}",
          "if (!pm.collectionVariables.get('password')) {",
          "  pm.collectionVariables.set('password', 'Password123');",
          "}",
          "if (!pm.collectionVariables.get('role')) {",
          "  pm.collectionVariables.set('role', 'USER');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Register - Success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = `${Date.now()}${Math.floor(Math.random() * 1000)}`;",
              "const phoneSuffix = String(Date.now()).slice(-7).padStart(7, '0');",
              "pm.collectionVariables.set('userEmail', `auth.postman.${stamp}@example.com`);",
              "pm.collectionVariables.set('userPhone', `039${phoneSuffix}`);",
              "pm.collectionVariables.unset('otp');",
              "pm.collectionVariables.unset('accessToken');",
              "pm.collectionVariables.unset('refreshToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('HTTP 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('ApiResponse success shape', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.statusCode).to.eql(201);",
              "  pm.expect(json.message).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('OTP returned and saved', function () {",
              "  pm.expect(json.data).to.match(/^\\d{6}$/);",
              "  pm.collectionVariables.set('otp', json.data);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{userPhone}}\",\n  \"email\": \"{{userEmail}}\",\n  \"fullName\": \"{{fullName}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Creates a pending user, sends OTP email, and returns OTP in data for test automation."
      },
      "response": []
    },
    {
      "name": "02 Verify OTP - Success",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "",
              "pm.test('HTTP 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Registration response includes tokens and user', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.statusCode).to.eql(201);",
              "  pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.refreshToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.data.user.email).to.eql(pm.collectionVariables.get('userEmail'));",
              "});",
              "",
              "pm.test('Response does not expose password', function () {",
              "  pm.expect(JSON.stringify(json.data.user)).to.not.include('password');",
              "});",
              "",
              "pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.data.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "verify-otp"
          ]
        },
        "description": "Verifies the OTP created by request 01 and persists the user."
      },
      "response": []
    },
