              "    pm.expect([400, 500]).to.include(json.status);",
              "  } else {",
              "    pm.expect(pm.response.text()).to.not.be.empty;",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/verify-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "verify-otp"
          ]
        },
        "description": "Covers VerifyOtpRequest OTP length validation."
      },
      "response": []
    },
